// Proaktif Görev Yönetim Aracı — Veritabanı Şeması
// Kullanım: backend/prisma/schema.prisma olarak kaydet → npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum Role {
  ADMIN
  MEMBER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  CARD_CREATED
  CARD_UPDATED
  CARD_MOVED
  CARD_ASSIGNED
  CARD_COMPLETED
  COMMENT_ADDED
  MEMBER_JOINED
  DEPENDENCY_ADDED
}

enum NotificationType {
  ASSIGNED // sana kart atandı
  BLOCKER_RESOLVED // seni bloklayan kart bitti
  DEADLINE_RISK // deadline riski tespit edildi
  STALE_CARD // kartın 7+ gündür hareketsiz
  WIP_EXCEEDED // sütun WIP limitini aştı
  ORG_INVITE // organizasyon daveti (beklemede)
  ORG_JOINED // organizasyona eklendin
  ORG_REMOVED // organizasyondan çıkarıldın
  PROJECT_CREATED // yeni proje oluşturuldu
  PROJECT_DELETED // bir proje silindi
  ROLE_CHANGED // rolün değiştirildi
  REQUEST_CREATED // uye yeni bir degisiklik talebi gonderdi (adminlere)
  REQUEST_APPROVED // talebin onaylandi
  REQUEST_REJECTED // talebin reddedildi
  MENTIONED // bir yorumda @isim ile etiketlendin
  AUTOMATION // bir otomasyon kurali seni bilgilendirdi
  WATCHED_CARD_ACTIVITY // izledigin bir kartta yorum/tasima oldu
}

enum AutomationTrigger {
  CARD_MOVED_TO_COLUMN // kart belirli bir kolona tasininca
  CARD_CREATED // kart olusturulunca (belirli bir kolonda veya herhangi birinde)
  SCHEDULED // gece taramasi (03:00) sirasinda gunun gunune gore tetiklenir
  CARD_DUE_SOON // teslim tarihine dueSoonDays gun kala, henuz Done olmayan kartlar icin
}

enum AutomationActionType {
  ADD_LABEL
  MOVE_TO_COLUMN
  ASSIGN_USER
  SEND_NOTIFICATION
  CREATE_CARD // SCHEDULED tetikleyicisiyle: actionColumnId'ye actionMessage basligiyla yeni kart acar
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

// CardDependency.relationType icin: sadece BLOCKS yonlu bekleme anlami tasir
// ve dongu kontrolune tabidir. Digerleri (RELATES_TO/DUPLICATES/CLONES) salt
// bilgilendirme amaclidir, dependency.service.ts'teki wouldCreateCycle
// kontrolu bunlar icin calismaz.
enum DependencyRelationType {
  BLOCKS
  RELATES_TO
  DUPLICATES
  CLONES
}

// Uyeler yapisal degisiklikleri dogrudan yapmaz; talep olustururlar.
// Admin onaylayinca talep otomatik uygulanir, reddedilince veri atilir.
enum ChangeRequestType {
  CARD_CREATE
  CARD_UPDATE
  CARD_DELETE
  COLUMN_CREATE
  PROJECT_CREATE
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ---------- MODELS ----------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  // null = email dogrulanmamis, giris engellenir. Google/Apple gibi OAuth
  // saglayicilar email'i kendisi dogruladigi icin oauthLogin'de otomatik set edilir.
  emailVerifiedAt DateTime?

  // Profil bilgileri: kullanici kendi doldurur. AI, gorev atarken (chat'teki
  // otomatik atama ve "AI ile Doldur") bu alanlari Badge'lerle birlikte
  // kullanarak icerige en uyumlu kisiyi onerir.
  title           String?
  bio             String?
  experience      String? // serbest metin: "2 yıl 3 ay", "6 ay", "Yeni başladım" vb.
  githubUrl       String?
  linkedinUrl     String? 
  expertiseAreas  String[] @default([]) 
  languages       String[] @default([]) 
  language        String   @default("tr") 
 
  // User-specific AI configurations
  aiProvider      String?
  aiApiKey        String?
  aiBaseUrl       String?
  aiModel         String?

  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]

  ownedOrganizations      Organization[]           @relation("OrganizationOwner")
  organizationMemberships OrganizationMember[]
  ownedProjects           Project[]                @relation("ProjectOwner")
  createdCards            Card[]                   @relation("CardCreator")
  assignedCards           CardAssignee[]
  comments                Comment[]
  activities              Activity[]
  notifications           Notification[]
  sentInvitations         OrganizationInvitation[] @relation("InvitationSender")
  receivedInvitations     OrganizationInvitation[] @relation("InvitationReceiver")
  chatMessages            ChatMessage[]
  changeRequests          ChangeRequest[]          @relation("ChangeRequestRequester")
  reviewedRequests        ChangeRequest[]          @relation("ChangeRequestReviewer")
  badges                  UserBadge[]
  uploadedAttachments     CardAttachment[]
  createdAutomationRules  AutomationRule[]
  watchedCards            CardWatcher[]
  createdCardTemplates    CardTemplate[]
}

// ---------- ORGANIZATION ----------

model Organization {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())

  owner          User                     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members        OrganizationMember[]
  projects       Project[]
  invitations    OrganizationInvitation[]
  chatMessages   ChatMessage[]
  changeRequests ChangeRequest[]
  badges         Badge[]
}

// Uyenin gonderdigi, admin onayi bekleyen degisiklik talebi.
// payload istenen veriyi tutar (kart basligi/aciklamasi vb.); onaylaninca
// ilgili servis cagrilarak uygulanir, reddedilince payload kullanilmaz.
model ChangeRequest {
  id             String              @id @default(cuid())
  organizationId String
  projectId      String? // PROJECT_CREATE talebinde henuz proje yok
  type           ChangeRequestType
  status         ChangeRequestStatus @default(PENDING)
  payload        Json // istenen alanlar
  targetCardId   String? // CARD_UPDATE / CARD_DELETE hedefi
  targetColumnId String? // CARD_CREATE'in ekleneceigi kolon
  requestedById  String
  reviewedById   String?
  reviewNote     String? // admin reddederken kisa gerekce
  createdAt      DateTime            @default(now())
  reviewedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("ChangeRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("ChangeRequestReviewer", fields: [reviewedById], references: [id])
  targetCard   Card?        @relation(fields: [targetCardId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([requestedById, status])
}

// Basit "tetikleyici -> aksiyon" otomasyonu (Trello Butler / Jira Automation'in
// hafif versiyonu). Hedef alanlar (actionLabelId/actionColumnId/actionUserId)
// bilerek gercek bir Prisma iliskisi DEGIL - ChangeRequest.targetColumnId ile
// ayni desen: referans verilen etiket/kolon/kullanici silinirse kural calisirken
// sessizce atlanir, DB seviyesinde bir bagimlilik kilidi olusturmaz.
model AutomationRule {
  id              String                @id @default(cuid())
  projectId       String
  name            String
  trigger         AutomationTrigger
  triggerColumnId String? // CARD_MOVED_TO_COLUMN: hedef kolon; CARD_CREATED: null = herhangi bir kolon
  actionType      AutomationActionType
  actionLabelId   String? // ADD_LABEL
  actionColumnId  String? // MOVE_TO_COLUMN
  actionUserId    String? // ASSIGN_USER / SEND_NOTIFICATION hedefi
  actionMessage   String? // SEND_NOTIFICATION icin ozel mesaj, CREATE_CARD icin yeni kartin basligi
  isActive        Boolean               @default(true)
  createdById     String
  createdAt       DateTime              @default(now())

  // SCHEDULED tetikleyici: gece taramasi (her gun 03:00) calistiginda gunun
  // gunu eslesirse (0=Pazar..6=Cumartesi) tetiklenir; null = her gun.
  scheduleDayOfWeek Int?
  // CARD_DUE_SOON tetikleyici: teslim tarihine kac gun kala tetiklenecegi
  dueSoonDays       Int?

  // Kosul (condition) filtreleri: ikisi de opsiyonel, null = filtre yok.
  // Tetikleyici gerceklestiginde kart bu kosullari saglamiyorsa aksiyon hic
  // calismaz (ClickUp'taki kosullu otomasyondan esinlenildi - basit "VE" mantigi,
  // ikisi de doluysa ikisi de saglanmali).
  conditionPriority Priority?
  conditionLabelId  String?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([projectId, trigger])
}

// Organizasyon basina tek sohbet odasi: uyeler ayni akista mesajlasir.
model ChatMessage {
  id             String   @id @default(cuid())
  organizationId String
  authorId       String
  text           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Davet edilen kullanici PENDING durumunda bekler, kabul edince
// OrganizationMember satiri olusturulur - "davet et = aninda uye yap"
// davranisi yerine onay adimi ekliyor.
model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  invitedUserId  String
  invitedById    String
  role           Role             @default(MEMBER)
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  respondedAt    DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedUser   User           @relation("InvitationReceiver", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy     User           @relation("InvitationSender", fields: [invitedById], references: [id])
  notifications Notification[]

  @@index([invitedUserId, status])
}

model OrganizationMember {
  organizationId String
  userId         String
  role           Role     @default(MEMBER)
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
}

// Yetkinlik / Rozet: Bir uyenin hangi alanlarda uzman oldugunu tanimlar.
// Orn: Backend, Frontend, DevOps, UI/UX, PLC Expert.
// Organizasyon bazlidir — her org kendi rozetlerini olusturur.
model Badge {
  id             String     @id @default(cuid())
  organizationId String
  name           String     // "Backend", "Frontend" vb.
  color          String     // hex renk: "#3B82F6"
  icon           String?    // emoji: "⚙️", opsiyonel
  createdAt      DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users         UserBadge[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Kullanici <-> Rozet iliskisi (M:N). Bir kullanici birden cok rozete,
// bir rozet birden cok kullaniciya sahip olabilir.
model UserBadge {
  userId     String
  badgeId    String
  assignedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

// ---------- PROJECT ----------

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  ownerId        String
  createdAt      DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  columns        Column[]
  labels         Label[]
  activities     Activity[]
  changeRequests ChangeRequest[]
  automationRules AutomationRule[]
  cardTemplates   CardTemplate[]
  sprints         Sprint[]
  customFields    CustomFieldDefinition[]
}

// Zaman kutulu iterasyon (Jira Sprint). Kartlar opsiyonel olarak bir sprint'e
// baglanir - sprint'e hic kart baglanmadan da board normal Kanban gibi
// calismaya devam eder, bu yuzden mevcut projelerde geriye donuk kirilma yok.
model Sprint {
  id        String       @id @default(cuid())
  projectId String
  name      String
  goal      String?
  status    SprintStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cards   Card[]

  @@index([projectId, status])
}

// Proje bazli ek kart alani tanimi (Jira Custom Fields). Deger, tipi ne
// olursa olsun String olarak saklanir; CHECKBOX icin "true"/"false", NUMBER
// icin sayinin string hali - parse/format sorumlulugu servis katmaninda.
model CustomFieldDefinition {
  id        String          @id @default(cuid())
  projectId String
  name      String
  type      CustomFieldType
  options   String[]        @default([]) // sadece SELECT tipi icin secenek listesi
  position  Float           @default(0)
  createdAt DateTime        @default(now())

  project Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  CardCustomFieldValue[]

  @@unique([projectId, name])
  @@index([projectId])
}

model CardCustomFieldValue {
  cardId  String
  fieldId String
  value   String?

  card  Card                  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  field CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([cardId, fieldId])
}

model Column {
  id        String  @id @default(cuid())
  projectId String
  name      String
  position  Float // fractional indexing: araya ekleme = (önceki+sonraki)/2
  wipLimit  Int? // Darboğaz uyarısı: aktif kart sayısı bunu aşarsa UI uyarır
  isDone    Boolean @default(false) // "Done" sütunu işareti → stale taraması bunu atlar

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cards   Card[]
}

model Card {
  id             String    @id @default(cuid())
  columnId       String
  title          String
  description    String?
  creatorId      String
  priority       Priority  @default(MEDIUM)
  storyPoints    Int? // Jira'daki story point/tahmini efor - insight motorundaki
  // is yuku hesabinda varsa oncelik agirligi yerine bu kullanilir (daha isabetli)
  dueDate        DateTime?
  startDate      DateTime?
  position       Float
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastActivityAt DateTime  @default(now()) // STALE MOTORUNUN KALBİ:
  // karta dokunan her işlem (taşıma, yorum, düzenleme, atama) bunu now() yapar.
  // Gece cron'u: lastActivityAt < now-7gün && column.isDone == false → stale

  sprintId String? // opsiyonel: bagli oldugu iterasyon (Jira Sprint benzeri)

  // Epic/alt-gorev hiyerarsisi (Jira Epic->Story). CardDependency'deki
  // blocker/blocked "sira" iliskisinden farkli olarak bu bir "aittir" iliskisi.
  parentCardId String?

  column  Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
  creator User   @relation("CardCreator", fields: [creatorId], references: [id])
  sprint  Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parent  Card?   @relation("CardParent", fields: [parentCardId], references: [id], onDelete: SetNull)

  comments          Comment[]
  labels            CardLabel[]
  assignees         CardAssignee[]
  blocking          CardDependency[] @relation("Blocker") // bu kartın blokladıkları
  blockedBy         CardDependency[] @relation("Blocked") // bu kartı bloklayanlar
  activities        Activity[]
  notifications     Notification[]
  changeRequests    ChangeRequest[]
  attachments       CardAttachment[]
  checklistItems    ChecklistItem[]
  watchers          CardWatcher[]
  subtasks          Card[]                 @relation("CardParent")
  customFieldValues CardCustomFieldValue[]

  @@index([columnId])
  @@index([lastActivityAt]) // cron taraması hızlı olsun
  @@index([sprintId])
  @@index([parentCardId])
}

// Coklu atama: bir kart birden fazla kisiye atanabilir (CardLabel ile ayni desen)
model CardAssignee {
  cardId String
  userId String

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
}

// Atanmamis ama karttaki gelismelerden (yorum, tasima) haberdar olmak
// isteyen kisiler. CardAssignee ile ayni desen ama sorumluluk anlami yok -
// sadece bildirim abonesi.
model CardWatcher {
  cardId    String
  userId    String
  createdAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  cardId    String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  card   Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}

model Label {
  id        String @id @default(cuid())
  projectId String
  name      String
  color     String // hex, örn: "#EF4444"

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cards   CardLabel[]
}

// Trello'daki kart sablonlari: sik kullanilan kart yapisini (checklist dahil)
// tekrar tekrar elle kurmamak icin. checklistItems duz bir String[] - ayri
// bir tablo gerektirmiyor, kart olusturulunca bunlar gercek ChecklistItem
// satirlarina donusturuluyor (bkz. template.service.ts).
model CardTemplate {
  id             String   @id @default(cuid())
  projectId      String
  name           String
  title          String
  description    String?
  priority       Priority @default(MEDIUM)
  storyPoints    Int?
  checklistItems String[] @default([])
  createdById    String
  createdAt      DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])
}

model CardLabel {
  cardId  String
  labelId String

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
}

// Karta eklenen dosya/gorsel. Gercek bayt Supabase Storage'daki private
// "card-attachments" bucket'inda durur (storagePath); bu satir sadece
// metadata tutar. Indirme linki her istekte kisa omurlu (1 saat) imzali
// URL olarak uretilir, storagePath asla dogrudan disari verilmez.
model CardAttachment {
  id          String   @id @default(cuid())
  cardId      String
  uploaderId  String
  fileName    String
  storagePath String
  fileSize    Int
  mimeType    String
  createdAt   DateTime @default(now())

  card     Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id])

  @@index([cardId])
}

// Kart icindeki alt gorev listesi (Trello'daki "Checklist"). Sirali (position,
// fractional indexing - CardAttachment/Comment'ten farkli olarak yeniden
// siralanabilir oldugu icin Card.position ile ayni desen kullanildi).
model ChecklistItem {
  id        String   @id @default(cuid())
  cardId    String
  text      String
  done      Boolean  @default(false)
  position  Float
  createdAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

// Self-referential N:N — "blocked by" ilişkisi
// Eklerken serviste DÖNGÜ KONTROLÜ şart: blocker'dan blocked'a
// zaten bir yol varsa (BFS/DFS) 400 dön, yoksa A→B→A kilitlenir.
model CardDependency {
  blockerId    String // BLOCKS: once bitmesi gereken kart. Digerlerinde sadece "ilk secilen kart"
  blockedId    String // BLOCKS: onu bekleyen kart. Digerlerinde sadece "ikinci secilen kart"
  relationType DependencyRelationType @default(BLOCKS)

  blocker Card @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Card @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

// Sifre sifirlama linki: HAM token e-postayla gider, DB'de sadece hash'i
// tutulur (linki gorenin/DB'yi dump edenin token'i kullanabilmesini onler).
// 1 saat sonra veya kullanildiktan sonra gecersiz sayilir.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Email dogrulama linki: PasswordResetToken ile ayni desen (ham token
// e-postayla gider, DB'de sadece hash'i tutulur). 24 saat gecerli —
// onboarding akisi oldugu icin sifre sifirlamadan (1 saat) daha uzun.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Beklenmeyen (AppError olmayan) hatalar buraya düşer. Route handler'lar
// handleApiError() üzerinden buraya yazar; validasyon/yetki gibi beklenen
// hatalar (400/401/403/404) burada YOK — sadece gerçek 500'ler loglanır.
model ErrorLog {
  id         String   @id @default(cuid())
  message    String
  stack      String?
  method     String
  path       String
  statusCode Int      @default(500)
  userId     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Her önemli olay buraya loglanır → haftalık özet + aktivite akışı buradan üretilir
model Activity {
  id        String       @id @default(cuid())
  projectId String
  cardId    String?
  userId    String
  type      ActivityType
  data      Json? // esnek detay, örn: { "from": "To Do", "to": "In Progress" }
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  card    Card?   @relation(fields: [cardId], references: [id], onDelete: SetNull)
  user    User    @relation(fields: [userId], references: [id])

  @@index([projectId, createdAt]) // haftalık özet sorgusu için
}

model Notification {
  id           String           @id @default(cuid())
  userId       String
  cardId       String?
  invitationId String?
  type         NotificationType
  message      String
  read         Boolean          @default(false)
  createdAt    DateTime         @default(now())

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  card       Card?                   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  invitation OrganizationInvitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
