// Proaktif Görev Yönetim Aracı — Veritabanı Şeması
// Kullanım: backend/prisma/schema.prisma olarak kaydet → npx prisma migrate dev --name init

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DATABASE_URL artik transaction-mode pooler'da (pgbouncer=true) - migration
  // motoru prepared statement kullaniyor, transaction-mode bunu desteklemiyor.
  // directUrl, migrate/db push icin session-mode pooler'a (eski DATABASE_URL)
  // gidiyor; runtime sorgulari etkilenmiyor.
  directUrl = env("DIRECT_URL")
}

// ---------- ENUMS ----------

enum Role {
  ADMIN
  MEMBER
  // Musteri/stajyer gibi organizasyona alinip yalnizca DAVET EDILDIGI
  // proje(ler)i gormesi gereken kisiler icin. Gorunurlukten (Project.
  // visibility) BAGIMSIZ olarak GUEST her zaman ProjectMember'a eklenmis
  // olmak zorunda - GUEST'in butun anlami bu.
  GUEST
}

// Kisitlayicilik artan sirayla: ORG (herkes) > TEAM (adminler + davetliler)
// > PRIVATE (sadece sahibi + davetliler, admin bile otomatik gormez).
enum ProjectVisibility {
  ORG
  TEAM
  PRIVATE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Sabit enum - proje bazinda tanimlanabilir tip listesi karti (kartin kendi
// onerisi) simdilik gereksiz karmasiklik katardi, bu bes tip is takibi icin
// yeterli.
enum CardType {
  EPIC
  STORY
  TASK
  BUG
  SUBTASK
}

// Proje bazli tercih: efor tahmini "puan" (story point, gorecelik) mi yoksa
// "saat" mi? Card.estimate her ikisinde de duz Int - birimi burada proje
// belirler, karti degil.
enum EstimateUnit {
  POINTS
  HOURS
}

enum ActivityType {
  CARD_CREATED
  CARD_UPDATED
  CARD_MOVED
  CARD_ASSIGNED
  CARD_COMPLETED
  COMMENT_ADDED
  MEMBER_JOINED
  DEPENDENCY_ADDED
}

enum NotificationType {
  ASSIGNED // sana kart atandı
  BLOCKER_RESOLVED // seni bloklayan kart bitti
  DEADLINE_RISK // deadline riski tespit edildi
  STALE_CARD // kartın 7+ gündür hareketsiz
  WIP_EXCEEDED // sütun WIP limitini aştı
  ORG_INVITE // organizasyon daveti (beklemede)
  ORG_JOINED // organizasyona eklendin
  ORG_REMOVED // organizasyondan çıkarıldın
  PROJECT_CREATED // yeni proje oluşturuldu
  PROJECT_DELETED // bir proje silindi
  ROLE_CHANGED // rolün değiştirildi
  REQUEST_CREATED // uye yeni bir degisiklik talebi gonderdi (adminlere)
  REQUEST_APPROVED // talebin onaylandi
  REQUEST_REJECTED // talebin reddedildi
  MENTIONED // bir yorumda @isim ile etiketlendin
  AUTOMATION // bir otomasyon kurali seni bilgilendirdi
  WATCHED_CARD_ACTIVITY // izledigin bir kartta yorum/tasima oldu
  MAIL_RECEIVED // sirket ici mailbox'a yeni mesaj geldi
  // NOT: Bu deger bir kez kaldirilip (c9aef48) geri eklendi. Eski surumdeki
  // "enum degeri veritabaninda birakildi" notu artik gecersiz - 04a2f4c
  // (20260804095500) enum'u USING ile yeniden yaratarak degeri gercekten
  // dusurdu. Yani bu migration degeri SIFIRDAN ekliyor.
}

enum AutomationTrigger {
  CARD_MOVED_TO_COLUMN // kart belirli bir kolona tasininca
  CARD_CREATED // kart olusturulunca (belirli bir kolonda veya herhangi birinde)
  SCHEDULED // gece taramasi (03:00) sirasinda gunun gunune gore tetiklenir
  CARD_DUE_SOON // teslim tarihine dueSoonDays gun kala, henuz Done olmayan kartlar icin
}

enum AutomationActionType {
  ADD_LABEL
  MOVE_TO_COLUMN
  ASSIGN_USER
  SEND_NOTIFICATION
  CREATE_CARD // SCHEDULED tetikleyicisiyle: actionColumnId'ye actionMessage basligiyla yeni kart acar
}


enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

// CardDependency.relationType icin: sadece BLOCKS yonlu bekleme anlami tasir
// ve dongu kontrolune tabidir. Digerleri (RELATES_TO/DUPLICATES/CLONES) salt
// bilgilendirme amaclidir, dependency.service.ts'teki wouldCreateCycle
// kontrolu bunlar icin calismaz.
enum DependencyRelationType {
  BLOCKS
  RELATES_TO
  DUPLICATES
  CLONES
}

// Uyeler yapisal degisiklikleri dogrudan yapmaz; talep olustururlar.
// Admin onaylayinca talep otomatik uygulanir, reddedilince veri atilir.
enum ChangeRequestType {
  CARD_CREATE
  CARD_UPDATE
  CARD_DELETE
  COLUMN_CREATE
  PROJECT_CREATE
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ---------- MODELS ----------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  // null = email dogrulanmamis, giris engellenir. Google/Apple gibi OAuth
  // saglayicilar email'i kendisi dogruladigi icin oauthLogin'de otomatik set edilir.
  emailVerifiedAt DateTime?

  // Profil bilgileri: kullanici kendi doldurur. AI, gorev atarken (chat'teki
  // otomatik atama ve "AI ile Doldur") bu alanlari Badge'lerle birlikte
  // kullanarak icerige en uyumlu kisiyi onerir.
  title           String?
  bio             String?
  experience      String? // serbest metin: "2 yıl 3 ay", "6 ay", "Yeni başladım" vb.
  githubUrl       String?
  linkedinUrl     String?

  // GitHub senkronundan gelen alanlar. Kullanicinin ELLE doldurdugu alanlardan
  // AYRI tutuluyorlar: bunlar GitHub'a ait olgular, karsiliklarinda kullanici
  // girdisi yok, bu yuzden her senkronda guvenle uzerine yazilabiliyorlar.
  // Ayni veriyi title/bio gibi ortak alanlara sikistirsaydik senkron ya
  // kullanicinin yazdigini ezerdi ya da veriyi atmak zorunda kalirdi.
  githubUsername  String?
  company         String?
  location        String?
  publicRepos     Int?
  githubSyncedAt  DateTime?
  expertiseAreas  String[] @default([])
  languages       String[] @default([])
  // Supabase Storage'daki genel (public) "avatars" bucket'ina yuklenmis
  // fotografin tam URL'i - CardAttachment'tan farkli olarak imzali URL
  // gerekmiyor, profil fotografi zaten herkese acik gosterilecek bir sey.
  avatarUrl       String?
  language        String   @default("tr")
  // Sabah 08:00 gunluk ozet e-postasi (yaklasan teslim tarihleri + yeni
  // atanan kartlar + bekleyen talepler) - varsayilan acik, kart kendi
  // notunda bunu daha degerli buluyor ("tarih koyup kimsenin gormemesi
  // ise yaramiyor").
  dailyDigestEnabled Boolean   @default(true)
  // Ayni gun icinde IKI KEZ gonderilmesini onler: hem in-process cron hem
  // GitHub Actions (Render uyku modu icin) ayni saatte tetikleyebiliyor
  // (bkz. cron.ts). Gonderilince bugunun tarihine guncellenir, sonraki
  // cagri ayni gun icin atlar.
  lastDigestSentAt   DateTime?
  // User-specific AI configurations
  aiProvider      String?
  aiApiKey        String?
  aiBaseUrl       String?
  aiModel         String?

  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  apiTokens                ApiToken[]

  ownedOrganizations      Organization[]           @relation("OrganizationOwner")
  organizationMemberships OrganizationMember[]
  ownedProjects           Project[]                @relation("ProjectOwner")
  createdCards            Card[]                   @relation("CardCreator")
  assignedCards           CardAssignee[]
  comments                Comment[]
  activities              Activity[]
  notifications           Notification[]
  notificationPrefs       UserNotificationPref[]
  sentInvitations         OrganizationInvitation[] @relation("InvitationSender")
  receivedInvitations     OrganizationInvitation[] @relation("InvitationReceiver")
  chatMessages            ChatMessage[]
  changeRequests          ChangeRequest[]          @relation("ChangeRequestRequester")
  reviewedRequests        ChangeRequest[]          @relation("ChangeRequestReviewer")
  badges                  UserBadge[]
  uploadedAttachments     CardAttachment[]
  createdAutomationRules  AutomationRule[]
  createdCardTemplates    CardTemplate[]
  createdProjectTemplates ProjectTemplate[]
  createdWebhooks         OutgoingWebhook[]
  watchedCards            CardWatcher[]
  uploadedProjectDocuments ProjectDocument[]
  archivedCards           Card[]                   @relation("CardArchivedBy")
  savedViews              SavedView[]
  resolvedComments        Comment[]                @relation("CommentResolvedBy")
  commentReactions        CommentReaction[]
  timeLogs                TimeLog[]
  projectMemberships      ProjectMember[]
  sentMails               Mail[]                   @relation("MailSender")
  receivedMails           MailRecipient[]           @relation("MailRecipientUser")
}

// ---------- ORGANIZATION ----------

model Organization {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())

  owner            User                     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members          OrganizationMember[]
  projects         Project[]
  invitations      OrganizationInvitation[]
  chatMessages     ChatMessage[]
  changeRequests   ChangeRequest[]
  badges           Badge[]
  projectTemplates ProjectTemplate[]
  mails            Mail[]
}

// Proje sablonu: yeni proje acarken hazir kolon+etiket setiyle baslamak
// icin. Org-scoped (proje HENUZ yokken secildigi icin proje-scoped olamaz -
// bkz. CardTemplate, o proje-scoped). Otomasyon kurallari ve ozel alanlar
// BILEREK disarida - trigger/action semasi karmasik, kartin kendisi de
// "LOW oncelik, kazanc sinirli" diyor; kolon+etiket asil sikinti (elle
// kurulan sey) buydu.
model ProjectTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  // [{ name, position, wipLimit?, isDone? }]
  columns        Json
  // [{ name, color }]
  labels         Json     @default("[]")
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
}

// Uyenin gonderdigi, admin onayi bekleyen degisiklik talebi.
// payload istenen veriyi tutar (kart basligi/aciklamasi vb.); onaylaninca
// ilgili servis cagrilarak uygulanir, reddedilince payload kullanilmaz.
model ChangeRequest {
  id             String              @id @default(cuid())
  organizationId String
  projectId      String? // PROJECT_CREATE talebinde henuz proje yok
  type           ChangeRequestType
  status         ChangeRequestStatus @default(PENDING)
  payload        Json // istenen alanlar
  targetCardId   String? // CARD_UPDATE / CARD_DELETE hedefi
  targetColumnId String? // CARD_CREATE'in ekleneceigi kolon
  requestedById  String
  reviewedById   String?
  reviewNote     String? // admin reddederken kisa gerekce
  createdAt      DateTime            @default(now())
  reviewedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("ChangeRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("ChangeRequestReviewer", fields: [reviewedById], references: [id])
  targetCard   Card?        @relation(fields: [targetCardId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([requestedById, status])
}

// Basit "tetikleyici -> aksiyon" otomasyonu (Trello Butler / Jira Automation'in
// hafif versiyonu). Hedef alanlar (actionLabelId/actionColumnId/actionUserId)
// bilerek gercek bir Prisma iliskisi DEGIL - ChangeRequest.targetColumnId ile
// ayni desen: referans verilen etiket/kolon/kullanici silinirse kural calisirken
// sessizce atlanir, DB seviyesinde bir bagimlilik kilidi olusturmaz.
model AutomationRule {
  id              String                @id @default(cuid())
  projectId       String
  name            String
  trigger         AutomationTrigger
  triggerColumnId String? // CARD_MOVED_TO_COLUMN: hedef kolon; CARD_CREATED: null = herhangi bir kolon
  actionType      AutomationActionType
  actionLabelId   String? // ADD_LABEL
  actionColumnId  String? // MOVE_TO_COLUMN
  actionUserId    String? // ASSIGN_USER / SEND_NOTIFICATION hedefi
  actionMessage   String? // SEND_NOTIFICATION icin ozel mesaj, CREATE_CARD icin yeni kartin basligi
  isActive        Boolean               @default(true)
  createdById     String
  createdAt       DateTime              @default(now())

  // SCHEDULED tetikleyici: gece taramasi (her gun 03:00) calistiginda gunun
  // gunu eslesirse (0=Pazar..6=Cumartesi) tetiklenir; null = her gun.
  scheduleDayOfWeek Int?
  // CARD_DUE_SOON tetikleyici: teslim tarihine kac gun kala tetiklenecegi
  dueSoonDays       Int?

  // Kosul (condition) filtreleri: ikisi de opsiyonel, null = filtre yok.
  // Tetikleyici gerceklestiginde kart bu kosullari saglamiyorsa aksiyon hic
  // calismaz (ClickUp'taki kosullu otomasyondan esinlenildi - basit "VE" mantigi,
  // ikisi de doluysa ikisi de saglanmali).
  conditionPriority Priority?
  conditionLabelId  String?

  // Kart detayindan "bunu her hafta tekrarla" ile olusturulan SCHEDULED+
  // CREATE_CARD kurallarini kaynak karta baglar - "bu kart tekrarlaniyor mu"
  // sorusunu basligin degismis olmasina karsi guvenilir sekilde cevaplar
  // (actionMessage'a gore eslestirmek kart yeniden adlandirilinca kirilirdi).
  // Kaynak kart silinirse kural CALISMAYA DEVAM eder (Butler'daki gibi tekrar
  // ayri bir kavram, tek bir orneginin silinmesiyle durmaz) - sadece referans
  // null'lanir.
  sourceCardId String?

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User    @relation(fields: [createdById], references: [id])
  sourceCard Card?   @relation("AutomationSourceCard", fields: [sourceCardId], references: [id], onDelete: SetNull)

  @@index([projectId, trigger])
  @@index([sourceCardId])
}

// Organizasyon basina tek sohbet odasi: uyeler ayni akista mesajlasir.
model ChatMessage {
  id             String   @id @default(cuid())
  organizationId String
  authorId       String
  text           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Davet edilen kullanici PENDING durumunda bekler, kabul edince
// OrganizationMember satiri olusturulur - "davet et = aninda uye yap"
// davranisi yerine onay adimi ekliyor.
model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  invitedUserId  String
  invitedById    String
  role           Role             @default(MEMBER)
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  respondedAt    DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedUser   User           @relation("InvitationReceiver", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy     User           @relation("InvitationSender", fields: [invitedById], references: [id])
  notifications Notification[]

  @@index([invitedUserId, status])
}

model OrganizationMember {
  organizationId String
  userId         String
  role           Role     @default(MEMBER)
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
}

// Yetkinlik / Rozet: Bir uyenin hangi alanlarda uzman oldugunu tanimlar.
// Orn: Backend, Frontend, DevOps, UI/UX, PLC Expert.
// Organizasyon bazlidir — her org kendi rozetlerini olusturur.
model Badge {
  id             String     @id @default(cuid())
  organizationId String
  name           String     // "Backend", "Frontend" vb.
  color          String     // hex renk: "#3B82F6"
  icon           String?    // emoji: "⚙️", opsiyonel
  createdAt      DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users         UserBadge[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Kullanici <-> Rozet iliskisi (M:N). Bir kullanici birden cok rozete,
// bir rozet birden cok kullaniciya sahip olabilir.
model UserBadge {
  userId     String
  badgeId    String
  assignedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

// ---------- PROJECT ----------

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  ownerId        String
  createdAt      DateTime @default(now())

  // İNSAN-OKUNUR KART ANAHTARI (Jira'daki PROJ-123 karşılığı)
  // key: 2-5 karakterlik proje öneki ("QNT"), organizasyon içinde benzersiz.
  // cardCounter: bu projede verilmiş SON kart numarası. Yeni kart açılırken
  // atomik olarak +1'lenip okunur (Postgres'te UPDATE ... RETURNING atomiktir),
  // böylece eşzamanlı iki kart aynı numarayı almaz. Silinen numara geri
  // kullanılmaz - anahtar kalıcı bir referans, geri dönüştürülemez.
  key            String
  cardCounter    Int      @default(0)
  estimateUnit   EstimateUnit @default(POINTS)
  // Varsayilan ORG: mevcut projelerin hepsi geriye donuk olarak eskisi
  // gibi (organizasyondaki herkese acik) davranmaya devam eder - bu
  // ozelligi acmadan hicbir proje aniden gizlenmez.
  visibility     ProjectVisibility @default(ORG)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  columns        Column[]
  labels         Label[]
  activities     Activity[]
  members        ProjectMember[]
  // organizasyon içinde tek: "QNT-42" bir org'da tek bir kartı gösterir
  changeRequests ChangeRequest[]
  automationRules AutomationRule[]
  cardTemplates   CardTemplate[]
  customFields    CustomFieldDefinition[]
  documents       ProjectDocument[]
  savedViews      SavedView[]
  webhooks        OutgoingWebhook[]

  @@unique([organizationId, key])
}

enum WebhookEvent {
  CARD_CREATED
  CARD_MOVED
  CARD_ASSIGNED
  CARD_COMMENTED
  CHANGE_REQUEST_APPROVED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

// Panodaki olaylarin disariya (Slack/Discord/kendi sistemine) akmasi -
// GUVENLIK: url sadece kayit ve GONDERIM aninda dogrulanir (bkz.
// utils/webhook-security.ts) - kullanicinin verdigi bir adrese sunucudan
// istek atildigi icin SSRF riski var, ozel/yerel IP'lere cikilamaz.
model OutgoingWebhook {
  id          String         @id @default(cuid())
  projectId   String
  url         String
  // HMAC-SHA256 imzalama sirri - gonderilen govdeyi X-Quantro-Signature
  // basligiyla dogrulamak icin aliciya (bir kere) gosterilir.
  secret      String
  events      WebhookEvent[]
  isActive    Boolean        @default(true)
  createdById String
  createdAt   DateTime       @default(now())

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User                @relation(fields: [createdById], references: [id])
  deliveries WebhookDelivery[]

  @@index([projectId])
}

// Her gonderim denemesinin kaydi - "olu mektup" (surekli basarisiz olan)
// gorunurlugu ve yeniden deneme sayaci icin.
model WebhookDelivery {
  id          String                @id @default(cuid())
  webhookId   String
  event       WebhookEvent
  payload     Json
  status      WebhookDeliveryStatus @default(PENDING)
  attempts    Int                   @default(0)
  lastError   String?
  createdAt   DateTime              @default(now())
  deliveredAt DateTime?

  webhook OutgoingWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
}

// Bir projeye ACIKCA verilmis erisim. ORG gorunurlukte hic kontrol
// EDILMEZ (herkes zaten gorur). TEAM/PRIVATE'te ve her zaman GUEST rolu
// icin bu tablo "davetli listesi" gorevi gorur - bkz. access-control.service.ts.
model ProjectMember {
  projectId String
  userId    String
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

// BoardFilters.tsx'teki filtre durumu (arama, oncelik, atanan, etiket)
// sayfa yenilenince kayboluyordu - "Bu haftaki gecikenler" gibi tekrar
// kullanilabilir bir gorunum yoktu. filters serbest bicimli JSON: frontend'in
// BoardFilters state'iyle birebir esleşir (search/priorities/assigneeIds/
// labelIds) - semada sabitlemek yeni bir filtre turu eklendiginde migration
// gerektirirdi, servis katmani da dogrulamiyor, sadece saklayip geri veriyor.
model SavedView {
  id        String   @id @default(cuid())
  projectId String
  ownerId   String
  name      String
  filters   Json
  // false: sadece sahibi gorur. true: proje/org'daki herkes gorur ama
  // yalnizca sahibi silebilir - "paylasilan" salt-okunur bir kisayoldur.
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Proje bazli ek kart alani tanimi (Jira Custom Fields). Deger, tipi ne
// olursa olsun String olarak saklanir; CHECKBOX icin "true"/"false", NUMBER
// icin sayinin string hali - parse/format sorumlulugu servis katmaninda.
model CustomFieldDefinition {
  id        String          @id @default(cuid())
  projectId String
  name      String
  type      CustomFieldType
  options   String[]        @default([]) // sadece SELECT tipi icin secenek listesi
  position  Float           @default(0)
  createdAt DateTime        @default(now())

  project Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  CardCustomFieldValue[]

  @@unique([projectId, name])
  @@index([projectId])
}

model CardCustomFieldValue {
  cardId  String
  fieldId String
  value   String?

  card  Card                  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  field CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([cardId, fieldId])
}

model Column {
  id        String  @id @default(cuid())
  projectId String
  name      String
  position  Float // fractional indexing: araya ekleme = (önceki+sonraki)/2
  wipLimit  Int? // Darboğaz uyarısı: aktif kart sayısı bunu aşarsa UI uyarır
  isDone    Boolean @default(false) // "Done" sütunu işareti → stale taraması bunu atlar

  // Kolon GECIS kurallari - bir karti BU koluna tasirken kontrol edilir.
  // OFF: kontrol yok (varsayilan, mevcut serbest davranis). WARN: ihlal
  // varsa tasima olur ama uyari donuyor. ENFORCE: ihlal varsa tasima
  // reddedilir (yalnizca ADMIN, updateCardSchema.force ile bypass edebilir).
  transitionMode           ColumnRuleMode @default(OFF)
  requireAssignee          Boolean        @default(false) // atanan zorunlu
  requireChecklistComplete Boolean        @default(false) // checklist'in tamami isaretli olmali (checklist yoksa kural saglanmis sayilir)
  requireDescription       Boolean        @default(false) // aciklama bos olamaz
  requireNoOpenBlockers    Boolean        @default(false) // bu karti bloklayan, Done olmayan bir kart olamaz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cards   Card[]

  // Pano her acilista kolonlari projectId ile cekiyor (board.service).
  // Index olmadan bu sorgu tum Column tablosunu tariyordu.
  @@index([projectId])
}

enum ColumnRuleMode {
  OFF
  WARN
  ENFORCE
}

model Card {
  id             String    @id @default(cuid())
  columnId       String
  // Proje içinde artan sıra numarası. Görünen anahtar: <project.key>-<number>
  // ("QNT-42"). Numara Project.cardCounter'dan atomik olarak alınır
  // (card-key.service.ts). Kartın projesi Column üzerinden bulunuyor, bu
  // yüzden veritabanı seviyesinde (projectId, number) tekilliği kurulamıyor;
  // tekilliği sayaç garanti ediyor.
  number         Int
  title          String
  description    String?
  creatorId      String
  priority       Priority  @default(MEDIUM)
  type           CardType  @default(TASK)
  // Efor tahmini - birimi (puan/saat) Project.estimateUnit belirler. Daha
  // once "storyPoints" olarak vardi, kullanimi sifirken kaldirilmisti
  // (20260804095500_remove_sprint_and_story_points) - bu kez kolon
  // basliginda toplam ve is yuku raporuna (insight.service.ts) gercekten
  // baglaniyor, olu alan olarak kalmiyor.
  estimate       Int?
  // Zaman takibi (Card.estimate'ten AYRI bir eksen - o kaba boyutlandirma/
  // kapasite plani icin, bu gercek saat/dakika). estimateMinutes elle
  // girilir. spentMinutes, TimeLog kayitlarinin toplaminin ONBELLEGI - her
  // okumada SUM() atmamak icin log eklenince/silininde burada guncellenir.
  estimateMinutes Int?
  spentMinutes    Int       @default(0)
  dueDate        DateTime?
  startDate      DateTime?
  position       Float
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  isArchived     Boolean   @default(false) // soft-delete: arsivlenen kart silinmez, listelerden gizlenir
  archivedAt     DateTime?
  archivedById   String? // arsiv ekraninda "kim arsivledi" gostermek icin - geri yuklerken temizlenir
  lastActivityAt DateTime  @default(now()) // STALE MOTORUNUN KALBİ:
  // karta dokunan her işlem (taşıma, yorum, düzenleme, atama) bunu now() yapar.
  // Gece cron'u: lastActivityAt < now-7gün && column.isDone == false → stale

  // Epic/alt-gorev hiyerarsisi (Jira Epic->Story). CardDependency'deki
  // blocker/blocked "sira" iliskisinden farkli olarak bu bir "aittir" iliskisi.
  parentCardId String?

  column     Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
  creator    User   @relation("CardCreator", fields: [creatorId], references: [id])
  parent     Card?  @relation("CardParent", fields: [parentCardId], references: [id], onDelete: SetNull)
  archivedBy User?  @relation("CardArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  comments          Comment[]
  labels            CardLabel[]
  assignees         CardAssignee[]
  blocking          CardDependency[] @relation("Blocker") // bu kartın blokladıkları
  blockedBy         CardDependency[] @relation("Blocked") // bu kartı bloklayanlar
  activities        Activity[]
  notifications     Notification[]
  changeRequests    ChangeRequest[]
  attachments       CardAttachment[]
  checklistItems    ChecklistItem[]
  subtasks          Card[]                 @relation("CardParent")
  customFieldValues CardCustomFieldValue[]
  watchers          CardWatcher[]
  timeLogs          TimeLog[]
  recurrenceRules   AutomationRule[]       @relation("AutomationSourceCard")

  @@index([columnId])
  @@index([lastActivityAt]) // cron taraması hızlı olsun
  @@index([parentCardId])
  @@index([number]) // "QNT-42" araması: proje kolonlarına join edip numaraya bakıyoruz
}

// Elle girilen zaman kaydi ("kim, ne zaman, ne kadar"). Baslat/durdur
// timer BILEREK yok - sekme kapanmasi, birden fazla cihaz, unutulan timer
// bambaska bir problem sinifi (kartin kendi onerisi: once manuel).
model TimeLog {
  id       String   @id @default(cuid())
  cardId   String
  userId   String
  minutes  Int
  note     String?
  // Isin YAPILDIGI gun (geriye donuk girise izin verir - "dun 2 saat
  // calistim" gibi) - createdAt kaydin sisteme girildigi an, ikisi farkli.
  loggedAt DateTime @default(now())
  createdAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

// Coklu atama: bir kart birden fazla kisiye atanabilir (CardLabel ile ayni desen)
model CardAssignee {
  cardId String
  userId String

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  // Bilesik birincil anahtar cardId ile BASLIYOR, dolayisiyla "bana atanan
  // kartlar" (dashboard.service) ve gunluk ozet gibi KULLANICIDAN baslayan
  // sorgular onu kullanamiyor ve tam tablo tariyordu.
  @@index([userId])
}

// Atanmamis ama karttaki gelismelerden (yorum, tasima) haberdar olmak isteyen
// kisiler. CardAssignee ile ayni desen ama SORUMLULUK anlami tasimaz - sadece
// bildirim aboneligi. Ayrimin onemi: eskiden bir isi takip etmek isteyenin tek
// yolu kendini karta atamakti, bu da "kim yapiyor" bilgisini bozuyordu.
//
// [userId, cardId] indeksi "izlediklerim" listesi icin: sorgu kullanicidan
// baslar, bilesik birincil anahtar ise cardId ile basliyor ve o yonde ise
// yaramaz.
model CardWatcher {
  cardId    String
  userId    String
  createdAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId, cardId])
}

model Comment {
  id        String    @id @default(cuid())
  cardId    String
  authorId  String
  text      String
  createdAt DateTime  @default(now())
  editedAt  DateTime? // duzenlendiyse dolar - "duzenlendi" etiketi icin

  // TEK SEVIYE thread (Slack modeli). Bir yanitin kendi parentCommentId'si
  // hep null'dur - serviste yanita yanit verilirse otomatik olarak kok
  // yoruma baglanir, sinirsiz ic ice yorum UI'da ve okumada felaket olurdu.
  parentCommentId String?

  // Cozuldu isareti sadece KOK yorumlar (thread) icin anlamli - yaniti
  // cozulmus isaretlemek serviste reddedilir. Yazar disinda herkes
  // cozebilir/acabilir (GitHub PR "resolve conversation" gibi takim eylemi).
  resolvedAt   DateTime?
  resolvedById String?

  card       Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author     User              @relation(fields: [authorId], references: [id])
  parent     Comment?          @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies    Comment[]         @relation("CommentReplies")
  resolvedBy User?             @relation("CommentResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  reactions  CommentReaction[]

  @@index([cardId])
  @@index([parentCommentId])
}

// Kisi basina ayni emoji ile bir kez reaksiyon verebilir, farkli emojilerle
// birden fazla verebilir - PK bu yuzden ucu birden (commentId, userId, emoji).
model CommentReaction {
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId, emoji])
}

model Label {
  id        String @id @default(cuid())
  projectId String
  name      String
  color     String // hex, örn: "#EF4444"

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cards   CardLabel[]
}

// Trello'daki kart sablonlari: sik kullanilan kart yapisini (checklist dahil)
// tekrar tekrar elle kurmamak icin. checklistItems duz bir String[] - ayri
// bir tablo gerektirmiyor, kart olusturulunca bunlar gercek ChecklistItem
// satirlarina donusturuluyor (bkz. template.service.ts).
model CardTemplate {
  id             String   @id @default(cuid())
  projectId      String
  name           String
  title          String
  description    String?
  priority       Priority @default(MEDIUM)
  checklistItems String[] @default([])
  createdById    String
  createdAt      DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])
}

model CardLabel {
  cardId  String
  labelId String

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
}

// Karta eklenen dosya/gorsel. Gercek bayt Supabase Storage'daki private
// "card-attachments" bucket'inda durur (storagePath); bu satir sadece
// metadata tutar. Indirme linki her istekte kisa omurlu (1 saat) imzali
// URL olarak uretilir, storagePath asla dogrudan disari verilmez.
model CardAttachment {
  id          String   @id @default(cuid())
  cardId      String
  uploaderId  String
  fileName    String
  storagePath String
  fileSize    Int
  mimeType    String
  createdAt   DateTime @default(now())

  card     Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id])

  @@index([cardId])
}

// Projeye ilişkin referans belgeleri (şartname, PRD, sözleşme vb.). CardAttachment
// ile ayni depolama deseni (Supabase Storage), farki: Card'a degil Project'e bagli
// ve MCP server'in metin icerigini okuyabilmesi icin extractedText sakliyor -
// her okuma isteginde docx/pdf'i yeniden parse etmemek icin yukleme aninda
// bir kez cikarilip veritabaninda tutuluyor.
model ProjectDocument {
  id            String   @id @default(cuid())
  projectId     String
  uploaderId    String
  fileName      String
  storagePath   String
  fileSize      Int
  mimeType      String
  extractedText String?  @db.Text
  createdAt     DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaderId], references: [id])

  @@index([projectId])
}

// Kart icindeki alt gorev listesi (Trello'daki "Checklist"). Sirali (position,
// fractional indexing - CardAttachment/Comment'ten farkli olarak yeniden
// siralanabilir oldugu icin Card.position ile ayni desen kullanildi).
model ChecklistItem {
  id        String   @id @default(cuid())
  cardId    String
  text      String
  done      Boolean  @default(false)
  position  Float
  createdAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

// Self-referential N:N — "blocked by" ilişkisi
// Eklerken serviste DÖNGÜ KONTROLÜ şart: blocker'dan blocked'a
// zaten bir yol varsa (BFS/DFS) 400 dön, yoksa A→B→A kilitlenir.
model CardDependency {
  blockerId    String // BLOCKS: once bitmesi gereken kart. Digerlerinde sadece "ilk secilen kart"
  blockedId    String // BLOCKS: onu bekleyen kart. Digerlerinde sadece "ikinci secilen kart"
  relationType DependencyRelationType @default(BLOCKS)

  blocker Card @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Card @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  // Anahtar blockerId ile basliyor; "bu karti KIM blokluyor" (kolon gecis
  // kurali requireNoOpenBlockers, kart detayi) blockedId'den sorguluyor ve
  // index olmadan tam tablo tariyordu.
  @@index([blockedId])
}

// Sifre sifirlama linki: HAM token e-postayla gider, DB'de sadece hash'i
// tutulur (linki gorenin/DB'yi dump edenin token'i kullanabilmesini onler).
// 1 saat sonra veya kullanildiktan sonra gecersiz sayilir.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Email dogrulama linki: PasswordResetToken ile ayni desen (ham token
// e-postayla gider, DB'de sadece hash'i tutulur). 24 saat gecerli —
// onboarding akisi oldugu icin sifre sifirlamadan (1 saat) daha uzun.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Kullanici basina API anahtari - MCP server ve diger dis araclar bununla
// kimlik dogruluyor. PasswordResetToken ile ayni desen: ham token DB'de
// TUTULMAZ, yalnizca sha256 hash'i saklanir. Boylece veritabanini goren biri
// (yedek, log, destek erisimi) kimsenin hesabina baglanamaz.
//
// JWT yerine ayri bir tur olmasinin sebebi: JWT kisa omurlu ve yenilenmesi
// tarayici oturumuna bagli - bir MCP server'in arka planda haftalarca
// calismasi gerekiyor. Bu token suresiz, ama kullanici istedigi an iptal
// edebiliyor (JWT'de bu mumkun degil, suresi dolana kadar gecerli kalir).
//
// prefix: ham token'in ilk karakterleri, DUZ METIN. Kullanici arayuzde
// "qtr_a1b2c3..." seklinde hangi anahtarin hangisi oldugunu ayirt edebilsin
// diye - tek basina ise yaramaz, dogrulama her zaman hash uzerinden.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique
  prefix     String
  createdAt  DateTime  @default(now())
  // Bilgi amacli: kullanici "bu anahtari hala bir yer kullaniyor mu"
  // sorusunu cevaplayabilsin ve kullanilmayanlari guvenle silsin.
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Beklenmeyen (AppError olmayan) hatalar buraya düşer. Route handler'lar
// handleApiError() üzerinden buraya yazar; validasyon/yetki gibi beklenen
// hatalar (400/401/403/404) burada YOK — sadece gerçek 500'ler loglanır.
model ErrorLog {
  id         String   @id @default(cuid())
  message    String
  stack      String?
  method     String
  path       String
  statusCode Int      @default(500)
  userId     String?
  // Hatanin hangi organizasyon baglaminda olustugu. Global admin yok;
  // adminler yalnizca kendi org'larinin hata kayitlarini gorebilsin diye
  // eklendi (org bazli izolasyon). HandleApiError, istek kimlik dogrulamasi
  // gecmisse ve org baglami biliniyorsa doldurur.
  organizationId String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Her önemli olay buraya loglanır → haftalık özet + aktivite akışı buradan üretilir
model Activity {
  id        String       @id @default(cuid())
  projectId String
  cardId    String?
  userId    String
  type      ActivityType
  data      Json? // esnek detay, örn: { "from": "To Do", "to": "In Progress" }
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  card    Card?   @relation(fields: [cardId], references: [id], onDelete: SetNull)
  user    User    @relation(fields: [userId], references: [id])

  @@index([projectId, createdAt]) // haftalık özet sorgusu için
}

model Notification {
  id           String           @id @default(cuid())
  userId       String
  cardId       String?
  invitationId String?
  type         NotificationType
  message      String
  read         Boolean          @default(false)
  createdAt    DateTime         @default(now())

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  card       Card?                   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  invitation OrganizationInvitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// Kullanicinin hangi bildirim tiplerini kapatigini tutar (sessize alma).
// Varsayilan: tum tipler acik; bu tabloda sadece kapatilan tiplerin satiri
// olur. enabled=false olan tipler icin bildirim OLUSTURULMAZ (skip-display
// degil skip-creation) - bu hem DB'yi hem socket'i bos yere mesgul etmez.
model UserNotificationPref {
  userId  String
  type    NotificationType
  enabled Boolean @default(false) // false = bu tip sessize alindi

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}

// ---------- SIRKET ICI MAILBOX ----------
// Kapali devre (internal) mesajlasma: yalnizca ayni organizasyonun uyeleri
// arasinda calisir, disaridan hicbir sey giremez. Alici listesi GONDERIM
// ANINDA sabitlenir (MailRecipient satirlari olusturulur) - grup secimi
// ("Tum organizasyon", "Proje X Ekibi") dinamik bir referans DEGIL, o anki
// uyelerin bir anlik goruntusu. Aksi halde biri projeden ayrilinca eski bir
// mailin "kime gitmisti" bilgisi sessizce degisirdi.
model Mail {
  id             String    @id @default(cuid())
  organizationId String
  senderId       String
  subject        String
  body           String
  // true iken hicbir alicinin gelen kutusunda GORUNMEZ ve bildirim gitmez -
  // MailRecipient satirlari onceden olusturulmus olabilir (taslak "kime
  // gidecek" bilgisini tutar), gonderilince isDraft false olur.
  isDraft        Boolean   @default(true)
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
  // Yanit/iletme zinciri. parentMailId dogrudan cevaplanan mesaji, threadId
  // ise konusmanin KOKUNU gosterir (kokun kendisinde threadId = kendi id'si).
  // Comment'teki parentCommentId deseninin ayni izdüsümü: zincir tek seviye
  // tutuluyor - bir yanita yanit verilince threadId degismiyor, boylece
  // konusmanin tamami tek bir esitlik sorgusuyla ( threadId = X ) cekilebilir.
  // onDelete: SetNull cunku bir mesajin silinmesi, baskalarinin kutusundaki
  // yanitlari yok etmemeli.
  parentMailId   String?
  threadId       String?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender       User             @relation("MailSender", fields: [senderId], references: [id], onDelete: Cascade)
  parent       Mail?            @relation("MailReplies", fields: [parentMailId], references: [id], onDelete: SetNull)
  replies      Mail[]           @relation("MailReplies")
  recipients   MailRecipient[]
  attachments  MailAttachment[]

  @@index([organizationId, senderId, isDraft, createdAt])
  @@index([threadId, createdAt])
  @@index([parentMailId])
}

model MailRecipient {
  mailId    String
  userId    String
  read      Boolean   @default(false)
  readAt    DateTime?
  // Alicinin KENDI gelen kutusundan silmesi - gonderenin Gonderilenler'ini
  // ya da diger alicilarin kutusunu etkilemez, CardWatcher'daki "kisisel
  // abonelik" mantiginin ayni izdüşümü.
  deletedAt DateTime?

  mail Mail @relation(fields: [mailId], references: [id], onDelete: Cascade)
  user User @relation("MailRecipientUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([mailId, userId])
  @@index([userId, read, deletedAt])
}

model MailAttachment {
  id          String   @id @default(cuid())
  mailId      String
  fileName    String
  storagePath String
  fileSize    Int
  mimeType    String
  createdAt   DateTime @default(now())

  mail Mail @relation(fields: [mailId], references: [id], onDelete: Cascade)

  @@index([mailId])
}
