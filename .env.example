DATABASE_URL="postgresql://postgres:devpass@localhost:5432/pmapp"
# Migration/db push icin session-mode baglanti. DATABASE_URL transaction-mode
# pooler'a (pgbouncer=true) isaret ettiginde migration motoru prepared
# statement kullanamaz; prisma bu adresi yalnizca migrate/generate icin
# kullanir, runtime sorgulari DATABASE_URL'den gider. Yerelde ikisi ayni olur.
DIRECT_URL="postgresql://postgres:devpass@localhost:5432/pmapp"
JWT_SECRET="degistirin"
PORT=4000

# Sentry hata izleme (bkz. src/instrument.ts). Bos birakilirsa Sentry devre
# disi kalir, uygulama normal calisir (ErrorLog tablosuna yazmayi surdurur).
SENTRY_DSN=""

# Kullanicilarin profildeki kendi AI API anahtarlarini (User.aiApiKey)
# sifrelemek icin (AES-256-GCM, bkz. utils/crypto.ts). Rastgele uzun bir
# deger uretip degistirmeden birakin - degisirse mevcut kullanicilarin
# kayitli anahtarlari cozulemez hale gelir (ozellik sessizce global
# saglayiciya duser, hata firlatmaz).
AI_KEY_SECRET="degistirin-uzun-rastgele-bir-deger"

# /api/scan (gece taramasi) icin paylasilan sir. GitHub Actions'daki
# nightly-scan.yml bunu "x-cron-secret" header'i olarak gonderir. Bos
# birakilirsa endpoint sadece giris yapmis + herhangi bir organizasyonda
# ADMIN olan kullanicilar tarafindan tetiklenebilir.
CRON_SECRET=""

# AI / LLM Configuration (AI Chat asistanı). AI_PROVIDER "openai" veya
# "google-gemini" olabilir - Groq/OpenRouter gibi openai-uyumlu servisler de
# "openai" + kendi AI_BASE_URL'leriyle calisir (bkz. utils/crypto.ts kullanan
# kullanici bazli konfigurasyon da ayni desende). Su an prod'da Groq kullanilir.
#
# Model olarak llama-3.1-8b-instant secildi (30 Tem 2026, 70b-versatile'den
# gecildi): 8b'nin Groq ucretsiz kotasi cok daha genis (30K TPM / 14.400 RPD
# vs 70b'nin 12K TPM / 1.000 RPD) - bu chat'in system prompt'u her mesajda
# TUM board'u (kolonlar+kartlar+uyeler) yeniden gonderdigi ve tool-calling
# donguleri 4 tura kadar cikabildigi icin 70b'nin dar kotasi normal kullanimda
# bile asiliyordu (bkz. getBoardContext). 8b, bu uygulamadaki gorevler
# (yapisal kart islemleri, basit siniflandirma) icin yeterli kaliteyi veriyor.
AI_PROVIDER="openai"
AI_API_KEY=""
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="llama-3.1-8b-instant"
# Google Gemini kullanmak icin: AI_PROVIDER="google-gemini", AI_BASE_URL'i
# bos birak, AI_MODEL="gemini-flash-latest"
FRONTEND_URL="https://your-frontend.onrender.com"

# Sifre sifirlama + email dogrulama postalari (Resend). Bos birakilirsa mail
# gonderilmez, link konsola yazilir (lokal gelistirme icin yeterli).
# onboarding@resend.dev Resend'in PAYLASIMLI sandbox domaini - bu haliyle
# sadece Resend hesabini acan kisinin kendi dogrulanmis adresine gonderim
# yapabilir. Herkese mail gitmesi icin kendi domaininizi Resend'de
# doğrulayip bu degeri (orn. "Tello <noreply@sizin-domaininiz.com>") degistirin
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Tello <onboarding@resend.dev>"

# Supabase Auth (Google OAuth) dogrulamasi icin - NEXT_PUBLIC_ onekli
# olanlardan AYRI, backend kendi kopyasini okur. Project Settings > API.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Kart ek dosyalari (Supabase Storage, "card-attachments" private bucket).
# Project Settings > API Keys > service_role. Bos birakilirsa yukleme
# 500 CONFIG_ERROR doner, digger ozellikler etkilenmez.
SUPABASE_SERVICE_ROLE_KEY=""
